# ==========================================
# ADVOCACY OS: Monorepo .gitignore
# ==========================================

# ------------------------------------------
# 1. SECRETS & ENV VARIABLES (CRITICAL)
# ------------------------------------------
.env
.env.local
.env.*
*.pem
duri.py

# ------------------------------------------
# 2. PYTHON / FASTAPI BACKEND
# ------------------------------------------
# Virtual Environments
.venv/
venv/
env/

# Compiled Python & Cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# ------------------------------------------
# 3. NODE / REACT FRONTEND
# ------------------------------------------
node_modules/
dist/
build/
.vite/
.eslintcache

# NPM/Yarn Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ------------------------------------------
# 4. OS & EDITOR FILES
# ------------------------------------------
# Mac OS (Since you are on a MacBook Air)
.DS_Store
.AppleDouble
.LSOverride

# IDEs
.vscode/
.idea/
*.swp